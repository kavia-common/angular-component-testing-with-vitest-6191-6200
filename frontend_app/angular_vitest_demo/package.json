{
  "name": "angular-vitest-demo",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "Angular-like component testing demo using Vitest within a React container (scoped).",
  "scripts": {
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/dom": "9.3.4",
    "@testing-library/user-event": "14.5.2",
    "@types/jest": "29.5.12",
    "jsdom": "25.0.1",
    "typescript": "5.5.4",
    "vite": "5.4.8",
    "vite-tsconfig-paths": "5.1.2",
    "vitest": "2.1.3",
    "@vitest/ui": "2.1.3",
    "@vitest/coverage-v8": "2.1.3"
  }
}
